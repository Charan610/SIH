# ============================================================
# .env.example — Template for secret settings
# ============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real API keys in .env
#   3. NEVER commit .env to Git (it has your secrets!)
#
# For testing without API keys, keep USE_MOCK_PROVIDERS=true
# ============================================================

# --- App Settings ---
APP_ENV=development
APP_DEBUG=true

# --- Groq (AI/LLM & Whisper STT) ---
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=put-your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL_PRIMARY=whisper-large-v3
WHISPER_MODEL_FALLBACK=whisper-large-v3-turbo

# --- Bhashini (Speech-to-Text & Text-to-Speech for Indian languages) ---
# Get your key at: https://bhashini.gov.in/ulca
BHASHINI_API_KEY=put-your-bhashini-api-key-here
BHASHINI_USER_ID=put-your-bhashini-user-id-here
BHASHINI_PIPELINE_ENDPOINT=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline

# --- Database ---
# This creates a file called skillsphere.db in the project folder
DATABASE_PATH=skillsphere.db

# --- Mock Mode ---
# Set to "true" if you DON'T have real API keys yet
# The app will use fake/sample responses instead
USE_MOCK_PROVIDERS=true

# --- Eligibility Rules (PM-AJAY GIA thresholds) ---
# These are configurable so you can adjust without changing code
GIA_INCOME_THRESHOLD=300000
GIA_MIN_AGE=14
GIA_MAX_AGE=45
